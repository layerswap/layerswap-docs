      {
        "header": "Layerswap",
        "items": [
          {
            "label": "App",
            "href": "https://layerswap.io/app"
          },
          {
            "label": "Explorer",
            "href": "https://layerswap.io/explorer"
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity"
    ]
  },
