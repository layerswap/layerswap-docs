  "background": {
    "color": {
      "dark": "#0C0A0E",
      "light": "#FEFCFD"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Dev Community",
        "href": "https://t.me/layerswap_dev"
      },
      {
        "label": "Github",
        "href": "https://github.com/layerswap/layerswapapp"
