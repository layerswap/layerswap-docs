    "primary": {
      "type": "button",
      "label": "Book a demo",
      "href": "https://cal.com/babgev/layerswap-demo"
    }
  },
  "seo": {
    "metatags": {
      "og:title": "Layerswap Docs",
      "og:description": "Layerswap makes cross-chain asset swapping & bridging accessible to everyone. Explore its features, supported networks, tokens, & integration options",
      "og:logo": "/logo/dark.svg"
    },
    "indexing": "navigable"
  },
  "footer": {
    "socials": {
      "x": "https://x.com/layerswap",
      "github": "https://github.com/layerswap",
      "telegram": "https://t.me/layerswap_io",
      "linkedin": "https://linkedin.com/company/layerswap"
    },
    "links": [
      {
        "header": "Resources",
        "items": [
          {
            "label": "Brand Assets",
            "href": "https://docs.layerswap.io/resources/brand-assets"
